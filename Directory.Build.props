<Project>
  <PropertyGroup>
    <!-- Single place to retarget the whole solution -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- .NET 8 reached end of support (Nov 2026); keep its advisories visible without breaking the build -->
    <WarningsNotAsErrors>NU1901;NU1902;NU1903;NU1904;NETSDK1138</WarningsNotAsErrors>
    <PlatformTarget>x64</PlatformTarget>
    <Version>1.0.0</Version>
    <!-- No debug symbols in any build output -->
    <DebugType>none</DebugType>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
</Project>
