<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Console application; WPF is used only for the user search window -->
    <OutputType>Exe</OutputType>
    <UseWPF>true</UseWPF>
    <AssemblyName>UserRemoveTool</AssemblyName>
    <RootNamespace>UserRemoveTool</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <!-- Startup time and memory -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <PublishSingleFile>false</PublishSingleFile>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <TieredPGO>false</TieredPGO>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\UserRemoveTool.Core\UserRemoveTool.Core.csproj" />
    <Content Include="appsettings.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\Launch.bat" Link="Launch.bat" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
