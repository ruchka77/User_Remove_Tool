<UserControl x:Class="UserRemoveTool.Views.GroupsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <DockPanel>
    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Title}" Text="סיכום והסרת קבוצות" />
    <Border DockPanel.Dock="Top" Background="White" BorderBrush="#DDDDDD" BorderThickness="1" Padding="12" Margin="0,0,0,12">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Style="{StaticResource Caption}" Text="שם מלא:" />
        <TextBlock Grid.Row="0" Grid.Column="1" Margin="0,2" Text="{Binding Record.DisplayName}" />
        <TextBlock Grid.Row="1" Style="{StaticResource Caption}" Text="שם משתמש:" />
        <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource LtrValue}" Text="{Binding Record.SamAccountName, Mode=OneWay}" />
        <TextBlock Grid.Row="2" Style="{StaticResource Caption}" Text="מייל:" />
        <TextBox Grid.Row="2" Grid.Column="1" Style="{StaticResource LtrValue}" Text="{Binding Record.Mail, Mode=OneWay}" />
        <TextBlock Grid.Row="3" Style="{StaticResource Caption}" Text="תיקיית בית:" />
        <TextBox Grid.Row="3" Grid.Column="1" Style="{StaticResource LtrValue}" Text="{Binding Record.HomeDirectory, Mode=OneWay}" />
        <TextBlock Grid.Row="4" Style="{StaticResource Caption}" Text="OU נוכחי:" />
        <TextBox Grid.Row="4" Grid.Column="1" Style="{StaticResource LtrValue}" Text="{Binding Record.CurrentOu, Mode=OneWay}" />
      </Grid>
    </Border>
    <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0" LastChildFill="False">
      <Button DockPanel.Dock="Left" Content="הסר קבוצות" Command="{Binding RemoveCommand}" />
      <Button DockPanel.Dock="Left" Content="רענן" Command="{Binding ReloadCommand}" Margin="8,0,0,0" />
      <Button DockPanel.Dock="Right" Content="המשך" Command="{Binding ContinueCommand}" />
      <Button DockPanel.Dock="Right" Content="חזרה לחיפוש" Command="{Binding BackCommand}" Margin="8,0" />
    </DockPanel>
    <ProgressBar DockPanel.Dock="Bottom" Height="8" Margin="0,8,0,0" Maximum="{Binding Total, Mode=OneWay}" Value="{Binding Handled, Mode=OneWay}"
                 AutomationProperties.Name="התקדמות הסרת קבוצות" />
    <TextBlock DockPanel.Dock="Bottom" Text="{Binding Status}" Margin="0,8,0,0" FontWeight="SemiBold" TextWrapping="Wrap" />
    <DataGrid ItemsSource="{Binding Groups}" AutomationProperties.Name="קבוצות המשתמש">
      <DataGrid.Columns>
        <DataGridTextColumn Header="קבוצה" Binding="{Binding Name}" Width="2*" ElementStyle="{StaticResource LtrCell}" />
        <DataGridTextColumn Header="סטטוס" Binding="{Binding StatusText}" Width="*" ElementStyle="{StaticResource Cell}" />
        <DataGridTextColumn Header="פירוט" Binding="{Binding Message}" Width="3*" ElementStyle="{StaticResource WrapCell}" />
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</UserControl>
