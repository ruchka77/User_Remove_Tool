<Window x:Class="UserRemoveTool.Views.SearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="חיפוש משתמש" FlowDirection="RightToLeft" Language="he-IL"
        Width="1250" Height="560" MinWidth="640" MinHeight="360"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" FontSize="14">
  <Window.Resources>
    <!-- Blue = proceed. Red (Danger) = cancel / close. -->
    <Style TargetType="Button">
      <Setter Property="Background" Value="#0078D4" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="Padding" Value="16,6" />
      <Setter Property="MinWidth" Value="90" />
      <Setter Property="Margin" Value="8,0,0,0" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="Black" /><Setter TargetName="Bd" Property="BorderThickness" Value="2" /></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Bd" Property="Opacity" Value="0.4" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Danger" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="#D13438" />
    </Style>
    <Style x:Key="Cell" TargetType="TextBlock">
      <Setter Property="Margin" Value="6,4" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="LtrCell" TargetType="TextBlock" BasedOn="{StaticResource Cell}">
      <Setter Property="FlowDirection" Value="LeftToRight" />
      <Setter Property="TextAlignment" Value="Right" />
    </Style>
  </Window.Resources>
  <DockPanel Margin="16">
    <TextBlock DockPanel.Dock="Top" Text="חיפוש לפי שם, שם משתמש, UPN, מייל, תעודת זהות או תיאור (↑↓ לבחירה, Enter או לחיצה כפולה להמשך):" Margin="0,0,0,4" />
    <TextBox x:Name="SearchBox" DockPanel.Dock="Top" FontSize="16" MaxLength="100" Padding="4" PreviewKeyDown="SearchBox_PreviewKeyDown"
             Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="חיפוש משתמש" />
    <TextBlock DockPanel.Dock="Top" Text="{Binding Status}" Margin="0,8" TextWrapping="Wrap" />
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Content="רענן מ-AD" Command="{Binding RefreshCommand}" />
      <Button Content="המשך" IsDefault="True" Command="{Binding ContinueCommand}" />
      <Button Content="ביטול" IsCancel="True" Style="{StaticResource Danger}" Command="{Binding CancelCommand}" />
    </StackPanel>
    <DataGrid x:Name="ResultsGrid" ItemsSource="{Binding Results}" MouseDoubleClick="ResultsGrid_MouseDoubleClick" PreviewKeyDown="ResultsGrid_PreviewKeyDown" SelectedItem="{Binding Selected}" AutoGenerateColumns="False"
              IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" SelectionMode="Single"
              AutomationProperties.Name="תוצאות חיפוש">
      <DataGrid.Columns>
        <DataGridTextColumn Header="שם מלא" Binding="{Binding DisplayName}" Width="2*" ElementStyle="{StaticResource Cell}" />
        <DataGridTextColumn Header="סוג" Binding="{Binding Kind}" Width="0.8*" ElementStyle="{StaticResource Cell}" />
        <DataGridTextColumn Header="תעודת זהות" Binding="{Binding NationalId}" Width="1.1*" ElementStyle="{StaticResource LtrCell}" />
        <DataGridTextColumn Header="שם משתמש" Binding="{Binding SamAccountName}" Width="1.2*" ElementStyle="{StaticResource LtrCell}" />
        <DataGridTextColumn Header="מייל" Binding="{Binding Email}" Width="2*" ElementStyle="{StaticResource LtrCell}" />
        <DataGridTextColumn Header="דומיין" Binding="{Binding Domain}" Width="1.3*" ElementStyle="{StaticResource LtrCell}" />
        <DataGridTextColumn Header="OU נוכחי" Binding="{Binding CurrentOu}" Width="3*" ElementStyle="{StaticResource LtrCell}" />
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</Window>
