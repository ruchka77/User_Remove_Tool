<UserControl x:Class="UserRemoveTool.Views.MoveView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <StackPanel>
    <TextBlock Style="{StaticResource Title}" Text="{Binding Title}" />
    <TextBlock Text="{Binding Message}" FontSize="16" TextWrapping="Wrap" Margin="0,0,0,16" />
    <Border Margin="0,0,0,16">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Style="{StaticResource Caption}" Text="שם מלא:" />
        <TextBlock Grid.Row="0" Grid.Column="1" Margin="0,2" Text="{Binding User.DisplayName}" />
        <TextBlock Grid.Row="1" Style="{StaticResource Caption}" Text="שם משתמש:" />
        <TextBox Grid.Row="1" Grid.Column="1" Style="{StaticResource LtrValue}" Text="{Binding User.SamAccountName, Mode=OneWay}" />
        <TextBlock Grid.Row="2" Style="{StaticResource Caption}" Text="OU נוכחי:" />
        <TextBox Grid.Row="2" Grid.Column="1" Style="{StaticResource LtrValue}" Text="{Binding User.CurrentOu, Mode=OneWay}" />
        <TextBlock Grid.Row="3" Style="{StaticResource Caption}" Text="OU יעד:" />
        <TextBox Grid.Row="3" Grid.Column="1" Style="{StaticResource LtrValue}" Text="{Binding TargetOu, Mode=OneWay}" />
      </Grid>
    </Border>
    <Button Content="{Binding ActionText}" Command="{Binding ExecuteCommand}" HorizontalAlignment="Left" />
    <TextBlock Text="{Binding Status}" Margin="0,12,0,0" FontWeight="SemiBold" TextWrapping="Wrap" />
  </StackPanel>
</UserControl>
