<Window x:Class="UserRemoveTool.Views.MessageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        FlowDirection="RightToLeft" Language="he-IL" FontFamily="Segoe UI" FontSize="14"
        Width="480" SizeToContent="Height" MaxHeight="600" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
  <DockPanel Margin="20">
    <TextBlock x:Name="Heading" DockPanel.Dock="Top" Style="{StaticResource Title}" />
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
      <Button x:Name="Ok" />
      <Button x:Name="Cancel" Style="{StaticResource Danger}" Content="ביטול" IsCancel="True" Margin="8,0,0,0" />
    </StackPanel>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <TextBlock x:Name="Body" TextWrapping="Wrap" />
    </ScrollViewer>
  </DockPanel>
</Window>
