<UserControl x:Class="UserRemoveTool.Views.SearchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <DockPanel>
    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Title}" Text="חיפוש משתמש" />
    <TextBlock DockPanel.Dock="Top" Text="שם מלא, שם פרטי, שם משפחה, שם משתמש או UPN:" Margin="0,0,0,4" />
    <TextBox x:Name="SearchBox" DockPanel.Dock="Top" FontSize="16" MaxLength="100"
             Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding Main.IsBusy, Mode=OneWay}"
             AutomationProperties.Name="חיפוש משתמש" />
    <TextBlock DockPanel.Dock="Top" Text="{Binding Status}" Margin="0,8" Foreground="#444444" TextWrapping="Wrap" />
    <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0" LastChildFill="False">
      <Button DockPanel.Dock="Right" Content="המשך" Command="{Binding ContinueCommand}" />
    </DockPanel>
    <DataGrid ItemsSource="{Binding Results}" SelectedItem="{Binding Selected}" AutomationProperties.Name="תוצאות חיפוש">
      <DataGrid.Columns>
        <DataGridTextColumn Header="שם מלא" Binding="{Binding DisplayName}" Width="2*" ElementStyle="{StaticResource Cell}" />
        <DataGridTextColumn Header="שם משתמש" Binding="{Binding SamAccountName}" Width="1.2*" ElementStyle="{StaticResource LtrCell}" />
        <DataGridTextColumn Header="מייל" Binding="{Binding Email}" Width="2*" ElementStyle="{StaticResource LtrCell}" />
        <DataGridTextColumn Header="OU נוכחי" Binding="{Binding CurrentOu}" Width="3*" ElementStyle="{StaticResource LtrCell}" />
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</UserControl>
