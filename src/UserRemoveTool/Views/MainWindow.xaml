<Window x:Class="UserRemoveTool.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:UserRemoveTool.ViewModels"
        xmlns:v="clr-namespace:UserRemoveTool.Views"
        Title="הסרת משתמש" FlowDirection="RightToLeft" Language="he-IL"
        Width="980" Height="680" MinWidth="760" MinHeight="560"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" FontSize="14"
        Background="#F5F5F5" UseLayoutRounding="True">
  <Window.Resources>
    <DataTemplate DataType="{x:Type vm:SearchViewModel}"><v:SearchView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:GroupsViewModel}"><v:GroupsView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:MoveViewModel}"><v:MoveView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:TicketViewModel}"><v:TicketView /></DataTemplate>
  </Window.Resources>
  <DockPanel>
    <Border DockPanel.Dock="Top" Background="White" BorderBrush="#DDDDDD" BorderThickness="0,0,0,1" Padding="20,12">
      <StackPanel>
        <TextBlock Text="{Binding StepText}" FontWeight="SemiBold" Margin="0,0,0,6" />
        <ProgressBar Height="10" Minimum="0" Maximum="{Binding TotalSteps, Mode=OneWay}" Value="{Binding CompletedSteps, Mode=OneWay}"
                     AutomationProperties.Name="התקדמות התהליך" />
      </StackPanel>
    </Border>
    <ContentControl Content="{Binding Page}" Margin="20" Focusable="False" />
  </DockPanel>
</Window>
