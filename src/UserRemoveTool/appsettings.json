{
  "ActiveDirectory": {
    "DomainController": "moia.gov.il",
    "TargetOu": "OU=Disabled Users,OU=Users,OU=MOIA,DC=moia,DC=gov,DC=il",
    "MaxResults": 1000,
    "MinSearchLength": 2,
    "SearchDelayMs": 250,

    // true: search the whole forest through the Global Catalog ("כל מדריך הכתובות"). false: only the domain above
    "SearchEntireDirectory": true,
    // Optional Global Catalog server name. Empty: found automatically
    "GlobalCatalogServer": "",
    // Also list contacts (they are shown but cannot be selected)
    "IncludeContacts": true,
    "TimeoutSeconds": 30
  },
  "ServiceDesk": {
    "Url": "http://kl-sd-app/CAisd/pdmweb.exe",
    "NewTicketUrl": "http://kl-sd-app/CAisd/html/popup_frames.html?POPUP_URLIX=0+popuptype=1",
    "AssigneeGroup": "סיסטם",
    "Assignee": "בכר, ברוך",
    "Source": "פורטל לפתיחת קריאות",
    "Status": "בהמתנה",
    "CategoryPath": [ "בקשת שירות", "אבטחת מידע", "ניהול משתמשים", "הסרת משתמש" ],
    "CategorySeparator": ".",

    // Used only when CA's short description is a single-line field, which cannot hold line breaks
    "SingleLineSeparator": " ",

    // Ways to open a new ticket, tried in order: PopupUrl, Menu, CreateNewUrl
    "OpenStrategies": [ "PopupUrl", "Menu", "CreateNewUrl" ],
    "MenuTexts": [ "קריאה חדשה", "קריאה חדשה..." ],
    "TicketFactory": "cr",
    "EdgePath": "",
    "LoginTimeoutSeconds": 180,
    "FormTimeoutSeconds": 15,

    // Where each field is in the CA form: CSS selectors first, then visible captions
    "Fields": {
      "Customer": {
        "Selectors": [ "[name='KEY.customer']", "[name='SET.customer.combo_name']" ],
        "Labels": [ "לקוח" ]
      },
      "Summary": {
        "Selectors": [ "[name='SET.summary']" ],
        "Labels": [ "תיאור מקוצר" ]
      },
      "Category": {
        "Selectors": [ "[name='KEY.category']", "select[name='SET.category']" ],
        "Labels": [ "קטגוריה" ]
      },
      "Source": {
        "Selectors": [],
        "Labels": [ "מקור הקריאה" ]
      },
      "Status": {
        "Selectors": [ "select[name='SET.status']", "[name='KEY.status']" ],
        "Labels": [ "סטטוס" ]
      },
      "AssigneeGroup": {
        "Selectors": [ "[name='KEY.group']", "select[name='SET.group']" ],
        "Labels": [ "צוות מטפל" ]
      },
      "Assignee": {
        "Selectors": [ "[name='KEY.assignee']", "select[name='SET.assignee']" ],
        "Labels": [ "גורם מטפל" ]
      }
    }
  },
  "Cache": {
    // Users from earlier searches are kept (encrypted for the current Windows user) for instant results; AD is still queried in the background
    "Enabled": true,
    "Directory": "cache",
    "TtlHours": 24
  },
  "Terminal": {
    // true: the program lays Hebrew out right to left itself (conhost / Windows Terminal draw text left to right only)
    "VisualHebrew": true,
    "Width": 80
  },
  "Logging": {
    "Directory": "%LOCALAPPDATA%\\UserRemoveTool\\Logs",

    // Optional: a central share for the audit log. Empty = same directory as above
    "AuditDirectory": ""
  }
}
