<Application x:Class="UserRemoveTool.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
  <Application.Resources>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="16,6" />
      <Setter Property="MinWidth" Value="90" />
      <Setter Property="MinHeight" Value="32" />
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Padding" Value="4" />
    </Style>
    <Style TargetType="DataGrid">
      <Setter Property="AutoGenerateColumns" Value="False" />
      <Setter Property="IsReadOnly" Value="True" />
      <Setter Property="CanUserAddRows" Value="False" />
      <Setter Property="HeadersVisibility" Value="Column" />
      <Setter Property="GridLinesVisibility" Value="Horizontal" />
      <Setter Property="HorizontalGridLinesBrush" Value="#E0E0E0" />
      <Setter Property="Background" Value="White" />
      <Setter Property="SelectionMode" Value="Single" />
    </Style>
    <Style TargetType="DataGridColumnHeader">
      <Setter Property="Padding" Value="8,6" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="Cell" TargetType="TextBlock">
      <Setter Property="Margin" Value="6,4" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
    </Style>
    <Style x:Key="WrapCell" TargetType="TextBlock">
      <Setter Property="Margin" Value="6,4" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <!-- Emails, paths and DNs read left to right but stay aligned with the Hebrew layout -->
    <Style x:Key="LtrCell" TargetType="TextBlock" BasedOn="{StaticResource Cell}">
      <Setter Property="FlowDirection" Value="LeftToRight" />
      <Setter Property="TextAlignment" Value="Right" />
    </Style>
    <Style x:Key="Title" TargetType="TextBlock">
      <Setter Property="FontSize" Value="20" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,0,0,12" />
    </Style>
    <Style x:Key="Caption" TargetType="TextBlock">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,2,12,2" />
    </Style>
    <Style x:Key="LtrValue" TargetType="TextBox">
      <Setter Property="IsReadOnly" Value="True" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="0,2" />
      <Setter Property="FlowDirection" Value="LeftToRight" />
      <Setter Property="TextAlignment" Value="Right" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
  </Application.Resources>
</Application>
